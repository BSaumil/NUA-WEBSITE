# Canonical origin for this deployment.
#
# Drives every absolute URL the site emits: canonical tags, og:url, sitemap.xml,
# robots.txt and structured data. Set this to move the site to another domain
# without touching application code.
#
# No trailing slash (one is stripped automatically if present).
# Defaults to https://nuapos.com.au when unset, so local dev and any
# unconfigured build behave exactly as before.
#
# Note: on GitHub Pages the domain the site is actually served from is bound
# separately by public/CNAME. Changing this variable alone changes what the site
# *says* its origin is, not where it is hosted — update both together.
REACT_APP_SITE_URL=https://nuapos.com.au
